//@version=6
indicator("Patterns : bull flag, triple creux, sweep", shorttitle="Patterns", overlay=true, max_boxes_count=100, max_lines_count=500, max_labels_count=500, max_bars_back=500)

// ── 1. Bull flag
useFlag     = input.bool(true, "Afficher", group="1. Bull flag")
poleLen     = input.int(12, "Mât : durée max (barres)", minval=2, maxval=50, group="1. Bull flag")
poleMinPct  = input.float(5.0, "Mât : hausse minimum (%)", minval=0.5, step=0.5, group="1. Bull flag")
poleAtr     = input.float(3.0, "Mât : hausse minimum (en ATR)", minval=0.5, step=0.5, group="1. Bull flag")
flagMin     = input.int(4, "Drapeau : durée min (barres)", minval=3, maxval=30, group="1. Bull flag")
flagMax     = input.int(20, "Drapeau : durée max (barres)", minval=4, maxval=40, group="1. Bull flag")
flagMaxRetr = input.float(50, "Drapeau : repli max (% du mât)", minval=10, maxval=100, group="1. Bull flag")
flagMaxUp   = input.float(0.05, "Drapeau : pente max (% par barre, 0 = doit baisser)", step=0.05, group="1. Bull flag")
flagVolDry  = input.bool(true, "Drapeau : volume plus faible que le mât", group="1. Bull flag")
brkVolMult  = input.float(1.2, "Cassure : volume ≥ x moyenne du drapeau", minval=0, step=0.1, group="1. Bull flag")

// ── 2. Triple creux
useTB       = input.bool(true, "Afficher", group="2. Triple creux")
pivLen      = input.int(5, "Creux : barres de chaque côté", minval=2, group="2. Triple creux")
tbTolPct    = input.float(1.5, "Écart max entre les 3 creux (%)", minval=0.1, step=0.1, group="2. Triple creux")
tbMinGap    = input.int(5, "Écart min entre creux (barres)", minval=1, group="2. Triple creux")
tbMaxSpan   = input.int(150, "Durée max du motif (barres)", minval=20, maxval=400, group="2. Triple creux")
tbMaxWait   = input.int(30, "Cassure attendue dans les N barres", minval=1, group="2. Triple creux")

// ── 3. Sweep + taux de réussite
useSweep    = input.bool(true, "Afficher", group="3. Sweep")
swPivLen    = input.int(5, "Plus bas de référence : barres de chaque côté", minval=2, group="3. Sweep")
swMaxAge    = input.int(100, "Plus bas de référence : âge max (barres)", minval=10, group="3. Sweep")
swWickPct   = input.float(40, "Mèche basse ≥ % de la bougie", minval=0, maxval=100, group="3. Sweep")
hideDown    = input.bool(false, "Masquer les sweeps en tendance baissière", group="3. Sweep")
tpR         = input.float(1.5, "Réussite = objectif à x fois le risque", minval=0.5, step=0.25, group="3. Sweep : statistiques", tooltip="Entrée à la clôture du sweep, stop sous la mèche. Réussi si l'objectif est touché avant le stop.")
maxHold     = input.int(30, "…dans les N barres (sinon échec)", minval=3, group="3. Sweep : statistiques")
showStats   = input.bool(false, "Tableau des statistiques", group="3. Sweep : statistiques")
consLen     = input.int(40, "Consolidation : durée (barres)", minval=10, maxval=300, group="3. Sweep : contexte")
consAtr     = input.float(6.0, "Consolidation : range ≤ x ATR", minval=1, step=0.5, group="3. Sweep : contexte")
trendLen    = input.int(50, "Tendance : EMA", minval=10, group="3. Sweep : contexte")
downSlope   = input.float(0.5, "Baissière : EMA en baisse d'au moins x % sur 10 barres", minval=0, step=0.1, group="3. Sweep : contexte")

// ── 4. Supports Daily / Weekly
useHtf      = input.bool(true, "Afficher", group="4. Supports D / W")
htfLen      = input.int(3, "Creux : bougies de chaque côté", minval=1, maxval=10, group="4. Supports D / W")
showD       = input.bool(true, "Supports Daily", group="4. Supports D / W")
showW       = input.bool(true, "Supports Weekly", group="4. Supports D / W")
htfCount    = input.int(3, "Nombre de supports affichés par unité", minval=1, maxval=4, group="4. Supports D / W")
htfMerge    = input.float(0.5, "Fusionner les niveaux à moins de x %", minval=0, step=0.1, group="4. Supports D / W")
htfNearPct  = input.float(0.8, "Sweep « sur support » si à moins de x %", minval=0, step=0.1, group="4. Supports D / W")
colD        = input.color(color.new(#7fb8a6, 0), "Couleur Daily", group="4. Supports D / W")
colW        = input.color(color.new(#2bb3f0, 0), "Couleur Weekly", group="4. Supports D / W")

atr = ta.atr(14)

// ═══ 1. BULL FLAG ═══════════════════════════════════════════════════════
// Pour chaque durée de drapeau L : le sommet du mât est à la barre [L] et domine tout le drapeau ;
// le mât monte vite (en % et en ATR) ; le drapeau est un canal plat ou descendant, repli limité,
// volume en baisse ; la barre actuelle clôture au-dessus de la ligne haute du canal, avec du volume.
var int lastFlagBar = na
flagBreak = false
float fGain = na
recentHi  = ta.highest(close, flagMin)[1]
preFilter = close > open and close > recentHi
if useFlag and preFilter and bar_index > flagMax + poleLen + 2 and (na(lastFlagBar) or bar_index - lastFlagBar > flagMin)
    for L = flagMin to flagMax
        top = high[L]
        isTop = true
        for k = 1 to L - 1
            if high[k] > top
                isTop := false
                break
        if not isTop
            continue
        pLow = low[L]
        pBar = L
        for k = L to L + poleLen - 1
            if low[k] < pLow
                pLow := low[k]
                pBar := k
        gain = (top / pLow - 1) * 100
        if gain < poleMinPct or top - pLow < poleAtr * atr[L] or pBar == L
            continue
        n = L - 1
        sx = 0.0
        sy = 0.0
        sxx = 0.0
        sxy = 0.0
        fLow = low[1]
        vFlag = 0.0
        for k = 1 to n
            x = float(n - k)
            sx += x
            sy += close[k]
            sxx += x * x
            sxy += x * close[k]
            fLow := math.min(fLow, low[k])
            vFlag += volume[k]
        den = n * sxx - sx * sx
        slope = den != 0 ? (n * sxy - sx * sy) / den : 0.0
        icpt = (sy - slope * sx) / n
        if slope / top * 100 > flagMaxUp
            continue
        retr = (top - fLow) / (top - pLow) * 100
        if retr > flagMaxRetr
            continue
        upDev = 0.0
        dnDev = 0.0
        for k = 1 to n
            reg = icpt + slope * (n - k)
            upDev := math.max(upDev, high[k] - reg)
            dnDev := math.max(dnDev, reg - low[k])
        vFlagAvg = vFlag / n
        vPole = 0.0
        for k = L to pBar
            vPole += volume[k]
        vPoleAvg = vPole / (pBar - L + 1)
        if flagVolDry and vFlagAvg >= vPoleAvg
            continue
        upperNow = icpt + slope * n + upDev
        if close > upperNow and volume >= brkVolMult * vFlagAvg
            flagBreak := true
            fGain := gain
            if barstate.isconfirmed
                lastFlagBar := bar_index
                x0 = bar_index - n
                line.new(bar_index - pBar, pLow, bar_index - L, top, color = color.aqua, width = 3)
                line.new(x0, icpt + upDev, bar_index, upperNow, color = color.new(color.aqua, 10))
                line.new(x0, icpt - dnDev, bar_index, icpt + slope * n - dnDev, color = color.new(color.aqua, 10))
                label.new(bar_index, low, "Bull flag\nmât +" + str.tostring(gain, "#.#") + "%", style = label.style_label_up, color = color.new(color.aqua, 20), textcolor = color.black, size = size.small)
            break

// ═══ 2. TRIPLE CREUX ════════════════════════════════════════════════════
pl = ta.pivotlow(low, pivLen, pivLen)
var array<float> plP = array.new<float>()
var array<int>   plB = array.new<int>()
var float tbNeck = na
var float tbLvl  = na
var int   tbBar3 = na
var int   tbBar1 = na
if not na(pl)
    array.push(plP, pl)
    array.push(plB, bar_index - pivLen)
    if array.size(plP) > 3
        array.shift(plP)
        array.shift(plB)
    if array.size(plP) == 3
        p1 = array.get(plP, 0)
        p2 = array.get(plP, 1)
        p3 = array.get(plP, 2)
        b1 = array.get(plB, 0)
        b2 = array.get(plB, 1)
        b3 = array.get(plB, 2)
        hiP = math.max(p1, p2, p3)
        loP = math.min(p1, p2, p3)
        okTol  = (hiP - loP) / loP * 100 <= tbTolPct
        okGap  = b2 - b1 >= tbMinGap and b3 - b2 >= tbMinGap
        okSpan = b3 - b1 <= tbMaxSpan
        if okTol and okGap and okSpan
            neck = 0.0
            for k = bar_index - b3 to bar_index - b1
                neck := math.max(neck, high[k])
            tbNeck := neck
            tbLvl  := loP
            tbBar3 := b3
            tbBar1 := b1

tbBreak = false
if useTB and not na(tbNeck)
    if bar_index - tbBar3 > tbMaxWait + pivLen or close < tbLvl
        tbNeck := na
    else if close > tbNeck and close[1] <= tbNeck and barstate.isconfirmed
        tbBreak := true
        line.new(tbBar1, tbLvl, bar_index, tbLvl, color = color.new(color.lime, 30), style = line.style_dashed)
        line.new(tbBar1, tbNeck, bar_index, tbNeck, color = color.lime, width = 2)
        label.new(bar_index, low, "Triple creux", style = label.style_label_up, color = color.new(color.lime, 20), textcolor = color.black, size = size.small)
        tbNeck := na

// ═══ 4. SUPPORTS DAILY / WEEKLY ═════════════════════════════════════════
htfPiv() =>
    pv = ta.pivotlow(low, htfLen, htfLen)
    found = not na(pv)
    [ta.valuewhen(found, pv, 0), ta.valuewhen(found, pv, 1), ta.valuewhen(found, pv, 2), ta.valuewhen(found, pv, 3)]

[d0, d1, d2, d3] = request.security(syminfo.tickerid, "D", htfPiv(), lookahead = barmerge.lookahead_off)
[w0, w1, w2, w3] = request.security(syminfo.tickerid, "W", htfPiv(), lookahead = barmerge.lookahead_off)

// supports = niveaux sous le prix, du plus proche au plus lointain
supportsBelow(float a0, float a1, float a2, float a3, float px) =>
    out = array.new<float>()
    for v in array.from(a0, a1, a2, a3)
        if not na(v) and v < px
            array.push(out, v)
    array.sort(out, order.descending)
    out

near(array<float> arr, float v, float pct) =>
    bool r = false
    for x in arr
        if math.abs(v / x - 1) * 100 <= pct
            r := true
    r

wLv = supportsBelow(w0, w1, w2, w3, close)
dLv = supportsBelow(d0, d1, d2, d3, close)
if not showW
    array.clear(wLv)
if not showD
    array.clear(dLv)

var array<line>  htfLines  = array.new<line>()
var array<label> htfLabels = array.new<label>()
if useHtf and barstate.islast
    for l in htfLines
        line.delete(l)
    for l in htfLabels
        label.delete(l)
    array.clear(htfLines)
    array.clear(htfLabels)
    drawn = array.new<float>()
    // Weekly d'abord (prioritaire), puis Daily sans doublon
    for tf = 0 to 1
        lv = array.copy(dLv)
        if tf == 0
            lv := array.copy(wLv)
        col = tf == 0 ? colW : colD
        n = 0
        for v in lv
            if n >= htfCount
                break
            if near(drawn, v, htfMerge)
                continue
            array.push(drawn, v)
            n += 1
            array.push(htfLines, line.new(math.max(0, bar_index - 120), v, bar_index, v, extend = extend.right, color = col, width = tf == 0 ? 2 : 1, style = tf == 0 ? line.style_solid : line.style_dashed))
            array.push(htfLabels, label.new(bar_index + 3, v, (tf == 0 ? "W " : "D ") + str.tostring(v, format.mintick) + "  " + str.tostring((v / close - 1) * 100, "#.#") + "%", style = label.style_label_left, color = color.new(color.black, 100), textcolor = col, size = size.small))

// ═══ 3. SWEEP + CONTEXTE + TAUX DE RÉUSSITE ═════════════════════════════
// contextes : 0 = après consolidation, 1 = tendance baissière, 2 = neutre
ema      = ta.ema(close, trendLen)
emaSlope = ema[10] != 0 ? (ema / ema[10] - 1) * 100 : 0.0
consRng  = ta.highest(high, consLen)[1] - ta.lowest(low, consLen)[1]
isCons   = consRng <= consAtr * atr[1] and math.abs(emaSlope) < downSlope
isDown   = not isCons and emaSlope <= -downSlope and close < ema
ctx      = isCons ? 0 : isDown ? 1 : 2

ctxName(int c) =>
    c == 0 ? "après consolidation" : c == 1 ? "tendance baissière" : "neutre"
ctxCol(int c) =>
    c == 0 ? color.lime : c == 1 ? color.red : color.orange

var array<int>   wins  = array.from(0, 0, 0)
var array<int>   total = array.from(0, 0, 0)
var array<float> tStop = array.new<float>()
var array<float> tTgt  = array.new<float>()
var array<int>   tCtx  = array.new<int>()
var array<int>   tBar  = array.new<int>()

// résolution des trades ouverts (barres clôturées, après la barre d'entrée)
if barstate.isconfirmed and array.size(tStop) > 0
    for i = array.size(tStop) - 1 to 0
        if bar_index <= array.get(tBar, i)
            continue
        hitStop = low <= array.get(tStop, i)
        hitTgt  = high >= array.get(tTgt, i)
        expired = bar_index - array.get(tBar, i) >= maxHold
        if hitStop or hitTgt or expired
            c = array.get(tCtx, i)
            array.set(total, c, array.get(total, c) + 1)
            if hitTgt and not hitStop          // les deux sur la même barre = compté en échec
                array.set(wins, c, array.get(wins, c) + 1)
            array.remove(tStop, i)
            array.remove(tTgt, i)
            array.remove(tCtx, i)
            array.remove(tBar, i)

spl = ta.pivotlow(low, swPivLen, swPivLen)
var float swLvl = na
var int   swBar = na
if not na(spl)
    swLvl := spl
    swBar := bar_index - swPivLen
range_  = high - low
lowWick = math.min(open, close) - low
sweep = useSweep and not na(swLvl) and bar_index - swBar <= swMaxAge and low < swLvl and close > swLvl and range_ > 0 and lowWick / range_ * 100 >= swWickPct
float swProb = na
if sweep and barstate.isconfirmed
    w = array.get(wins, ctx)
    t = array.get(total, ctx)
    swProb := t > 0 ? float(w) / t * 100 : na
    risk = close - low
    if risk > 0
        array.push(tStop, low)
        array.push(tTgt, close + tpR * risk)
        array.push(tCtx, ctx)
        array.push(tBar, bar_index)
    if not (hideDown and ctx == 1)
        probTxt = t < 5 ? "historique insuffisant (" + str.tostring(t) + ")" : str.tostring(swProb, "#") + "% réussite (" + str.tostring(t) + " cas)"
        onSup = useHtf ? (near(wLv, low, htfNearPct) ? " sur support W" : near(dLv, low, htfNearPct) ? " sur support D" : "") : ""
        line.new(swBar, swLvl, bar_index, swLvl, color = color.new(ctxCol(ctx), 30), style = line.style_dotted)
        label.new(bar_index, low, onSup == "" ? "Sweep" : "Sweep" + (str.contains(onSup, "W") ? " W" : " D"), style = label.style_label_up, color = color.new(ctxCol(ctx), 20), textcolor = color.black, size = size.tiny, tooltip = "Sweep " + ctxName(ctx) + onSup + " : " + probTxt + ". Réussite = objectif " + str.tostring(tpR) + "R avant le stop (sous la mèche), en " + str.tostring(maxHold) + " barres max, sur l'historique de ce graphique.")
    swLvl := na

var table st = table.new(position.bottom_right, 3, 5, bgcolor = color.new(color.black, 15), border_width = 1)
if showStats and useSweep and barstate.islast
    table.cell(st, 0, 0, "Sweep (" + str.tostring(tpR) + "R en " + str.tostring(maxHold) + " b.)", text_color = color.white, text_size = size.small)
    table.cell(st, 1, 0, "Cas", text_color = color.white, text_size = size.small)
    table.cell(st, 2, 0, "Réussite", text_color = color.white, text_size = size.small)
    for c = 0 to 2
        t = array.get(total, c)
        w = array.get(wins, c)
        table.cell(st, 0, c + 1, ctxName(c), text_color = ctxCol(c), text_size = size.small)
        table.cell(st, 1, c + 1, str.tostring(t), text_color = color.silver, text_size = size.small)
        table.cell(st, 2, c + 1, t > 0 ? str.tostring(float(w) / t * 100, "#") + "%" : "–", text_color = color.white, text_size = size.small)
    table.cell(st, 0, 4, "Maintenant : " + ctxName(ctx), text_color = ctxCol(ctx), text_size = size.tiny)

// ═══ ALERTES ════════════════════════════════════════════════════════════
alertcondition(flagBreak, "Bull flag", "Bull flag cassé sur {{ticker}} ({{interval}})")
alertcondition(tbBreak, "Triple creux", "Triple creux cassé sur {{ticker}} ({{interval}})")
alertcondition(sweep and ctx == 0, "Sweep après consolidation", "Sweep après consolidation sur {{ticker}} ({{interval}})")
sweepOnSup = sweep and useHtf and (near(wLv, low, htfNearPct) or near(dLv, low, htfNearPct))
alertcondition(sweepOnSup, "Sweep sur support D/W", "Sweep sur un support Daily/Weekly : {{ticker}} ({{interval}})")
alertcondition(sweep, "Sweep (tous)", "Sweep d'un plus bas sur {{ticker}} ({{interval}})")
if barstate.isconfirmed
    if flagBreak
        alert("Bull flag : " + syminfo.ticker + " " + timeframe.period + " (mât +" + str.tostring(fGain, "#.#") + "%)", alert.freq_once_per_bar_close)
    if tbBreak
        alert("Triple creux : " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
    if sweep and not (hideDown and ctx == 1)
        sup = useHtf ? (near(wLv, low, htfNearPct) ? " sur support W" : near(dLv, low, htfNearPct) ? " sur support D" : "") : ""
        alert("Sweep " + ctxName(ctx) + sup + " : " + syminfo.ticker + " " + timeframe.period, alert.freq_once_per_bar_close)
