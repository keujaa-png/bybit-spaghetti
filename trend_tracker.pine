//@version=6
indicator("Trend Tracker 55j (Bybit)", shorttitle="Trend Tracker", overlay=true, max_lines_count=50, max_labels_count=20)

// Suivi de tendance sur plusieurs semaines :
//   • ENTRÉE : la clôture daily dépasse le plus haut des {boLen} derniers jours
//   • SORTIE : la clôture daily passe sous le plus bas des {trailLen} derniers jours (stop suiveur, pas d'objectif fixe)
// Le panneau liste les coins actuellement en tendance, le gain depuis la cassure et le niveau de stop.
// Tout est calculé sur bougies daily clôturées : pas de repaint.

boLen     = input.int(55, "Cassure : plus haut des N jours", minval=10, maxval=200, group="Règles")
trailLen  = input.int(20, "Stop suiveur : plus bas des N jours", minval=5, maxval=60, group="Règles", tooltip="Plus le stop est large, plus on garde les grosses tendances. 10 j coupe trop tôt.")
sortBy    = input.string("Gain", "Trier par", options=["Gain", "Ancienneté", "Nom"], group="Affichage")
showAll   = input.bool(false, "Afficher aussi les coins hors tendance", group="Affichage")
tblPos    = input.string("Haut gauche", "Position du panneau", options=["Haut droite", "Haut gauche", "Bas droite", "Bas gauche"], group="Affichage")
showLines = input.bool(true, "Tracer la cassure et le stop sur le coin affiché", group="Graphique")

