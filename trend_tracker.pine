[p33, e33, a33, s33, b33, m33, w33, x33, c33, t33, _hi33] = request.security(sy33, "D", trackD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[p34, e34, a34, s34, b34, m34, w34, x34, c34, t34, _hi34] = request.security(sy34, "D", trackD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
