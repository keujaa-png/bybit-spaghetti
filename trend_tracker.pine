[p37, e37, a37, s37, b37, m37, w37, x37, c37, t37, _hi37] = request.security(sy37, "D", trackD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[p38, e38, a38, s38, b38, m38, w38, x38, c38, t38, _hi38] = request.security(sy38, "D", trackD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

[myPos, myEntry, myTentry, myStop, myBars, myPeak, myNew, myExit, myClose, myTime, myBO] = request.security(syminfo.tickerid, "D", trackD(), lookahead = barmerge.lookahead_on)

tick(string s) =>
    str.replace(str.replace(str.replace(s, "BYBIT:", ""), ".P", ""), "USDT", "")

pos = tblPos == "Haut droite" ? position.top_right : tblPos == "Bas droite" ? position.bottom_right : tblPos == "Bas gauche" ? position.bottom_left : position.top_left
var table tb = table.new(pos, 5, 40, bgcolor = color.new(color.black, 12), border_width = 1)
newDay = timeframe.change("D")

if barstate.islast
    sys = array.from(sy01, sy02, sy03, sy04, sy05, sy06, sy07, sy08, sy09, sy10, sy11, sy12, sy13, sy14, sy15, sy16, sy17, sy18, sy19, sy20, sy21, sy22, sy23, sy24, sy25, sy26, sy27, sy28, sy29, sy30, sy31, sy32, sy33, sy34, sy35, sy36, sy37, sy38)
    ps = array.from(p01, p02, p03, p04, p05, p06, p07, p08, p09, p10, p11, p12, p13, p14, p15, p16, p17, p18, p19, p20, p21, p22, p23, p24, p25, p26, p27, p28, p29, p30, p31, p32, p33, p34, p35, p36, p37, p38)
    es = array.from(e01, e02, e03, e04, e05, e06, e07, e08, e09, e10, e11, e12, e13, e14, e15, e16, e17, e18, e19, e20, e21, e22, e23, e24, e25, e26, e27, e28, e29, e30, e31, e32, e33, e34, e35, e36, e37, e38)
    ays = array.from(a01, a02, a03, a04, a05, a06, a07, a08, a09, a10, a11, a12, a13, a14, a15, a16, a17, a18, a19, a20, a21, a22, a23, a24, a25, a26, a27, a28, a29, a30, a31, a32, a33, a34, a35, a36, a37, a38)
    ss = array.from(s01, s02, s03, s04, s05, s06, s07, s08, s09, s10, s11, s12, s13, s14, s15, s16, s17, s18, s19, s20, s21, s22, s23, s24, s25, s26, s27, s28, s29, s30, s31, s32, s33, s34, s35, s36, s37, s38)
    bs = array.from(b01, b02, b03, b04, b05, b06, b07, b08, b09, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24, b25, b26, b27, b28, b29, b30, b31, b32, b33, b34, b35, b36, b37, b38)
    ms = array.from(m01, m02, m03, m04, m05, m06, m07, m08, m09, m10, m11, m12, m13, m14, m15, m16, m17, m18, m19, m20, m21, m22, m23, m24, m25, m26, m27, m28, m29, m30, m31, m32, m33, m34, m35, m36, m37, m38)
    ws = array.from(w01, w02, w03, w04, w05, w06, w07, w08, w09, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, w28, w29, w30, w31, w32, w33, w34, w35, w36, w37, w38)
    xs = array.from(x01, x02, x03, x04, x05, x06, x07, x08, x09, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29, x30, x31, x32, x33, x34, x35, x36, x37, x38)
    cs = array.from(c01, c02, c03, c04, c05, c06, c07, c08, c09, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30, c31, c32, c33, c34, c35, c36, c37, c38)
    ts = array.from(t01, t02, t03, t04, t05, t06, t07, t08, t09, t10, t11, t12, t13, t14, t15, t16, t17, t18, t19, t20, t21, t22, t23, t24, t25, t26, t27, t28, t29, t30, t31, t32, t33, t34, t35, t36, t37, t38)
    // classement
    key = array.new<float>()
    for i = 0 to 37
        gain = array.get(ps, i) and array.get(es, i) > 0 ? (array.get(cs, i) / array.get(es, i) - 1) * 100 : na
        v = sortBy == "Gain" ? (na(gain) ? -1e9 : gain) : sortBy == "Ancienneté" ? (array.get(ps, i) ? float(array.get(bs, i)) : -1e9) : float(-i)
        array.push(key, na(array.get(ts, i)) ? -1e9 : v)
    ordr = array.sort_indices(key, order.descending)

    table.clear(tb, 0, 0, 4, 39)
    nPos = 0
    for i = 0 to 37
        if array.get(ps, i)
            nPos += 1
    table.cell(tb, 0, 0, "Tendance " + str.tostring(boLen) + "j · " + str.tostring(nPos) + " coins", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, "Depuis", text_color = color.white, text_size = size.small)
    table.cell(tb, 2, 0, "Gain", text_color = color.white, text_size = size.small)
    table.cell(tb, 3, 0, "Stop suiveur", text_color = color.white, text_size = size.small)
    table.cell(tb, 4, 0, "Marge", text_color = color.white, text_size = size.small)
    string msgBO = ""
    string msgEx = ""
    int row = 1
    for r = 0 to array.size(ordr) - 1
        i = array.get(ordr, r)
        if na(array.get(ts, i))
            continue
        name = tick(array.get(sys, i))
        inpos = array.get(ps, i)
        if not inpos and not showAll
            continue
        if row > 38
            break
        px = array.get(cs, i)
        stop = array.get(ss, i)
        if inpos
            entry = array.get(es, i)
            gain = entry > 0 ? (px / entry - 1) * 100 : na
            marge = stop > 0 and px > 0 ? (px / stop - 1) * 100 : na
            fresh = array.get(ws, i)
            table.cell(tb, 0, row, name + (fresh ? " 🆕" : ""), text_color = fresh ? color.aqua : color.white, text_size = size.small)
            table.cell(tb, 1, row, str.tostring(array.get(bs, i) + 1) + " j", text_color = color.silver, text_size = size.small)
            table.cell(tb, 2, row, (gain >= 0 ? "+" : "") + str.tostring(gain, "#") + "%", text_color = gain >= 0 ? color.lime : color.red, text_size = size.small)
            table.cell(tb, 3, row, str.tostring(stop, format.mintick), text_color = color.orange, text_size = size.small)
            table.cell(tb, 4, row, str.tostring(marge, "#") + "%", text_color = marge < 5 ? color.red : color.silver, text_size = size.small)
        else
            table.cell(tb, 0, row, name, text_color = color.gray, text_size = size.small)
            table.cell(tb, 1, row, "–", text_color = color.gray, text_size = size.small)
            table.cell(tb, 2, row, "", text_size = size.small)
            table.cell(tb, 3, row, "", text_size = size.small)
            table.cell(tb, 4, row, "", text_size = size.small)
        row += 1
        if newDay
            if array.get(ws, i)
                msgBO += name + " (stop " + str.tostring(stop, format.mintick) + ")  "
            if array.get(xs, i)
                msgEx += name + "  "
    if str.length(msgBO) > 0 or str.length(msgEx) > 0
        alert((str.length(msgBO) > 0 ? "🚀 Nouvelle tendance " + str.tostring(boLen) + "j : " + msgBO : "") + (str.length(msgEx) > 0 ? " · ⛔ Stop suiveur touché : " + msgEx : ""), alert.freq_once_per_bar)

// ── cassure et stop sur le coin affiché ────────────────────────────────
plot(showLines ? myBO : na, "Niveau de cassure", color = color.new(color.aqua, 30), style = plot.style_stepline, linewidth = 1)
plot(showLines and myPos ? myStop : na, "Stop suiveur", color = color.new(color.orange, 0), style = plot.style_stepline, linewidth = 2)
bgcolor(showLines and myPos ? color.new(color.lime, 94) : na)
