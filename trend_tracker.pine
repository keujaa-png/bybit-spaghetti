trackD() =>
    hiBO = ta.highest(high, boLen)[1]
    trail = ta.lowest(low, trailLen)[1]
    var bool inPos = false
    var float entry = na
    var int tEntry = na
    var float peak = na
    var int barsIn = 0
    bool newBO = false
    bool exited = false
    if inPos
        if close < trail
            inPos := false
            exited := true
        else
            peak := math.max(peak, high)
            barsIn += 1
    if not inPos and close > hiBO
        inPos := true
        entry := close
        tEntry := time
        peak := high
        barsIn := 0
        newBO := true
    [inPos[1], entry[1], tEntry[1], trail, barsIn[1], peak[1], newBO[1], exited[1], close, time[1], hiBO]

[p01, e01, a01, s01, b01, m01, w01, x01, c01, t01, _hi01] = request.security(sy01, "D", trackD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[p02, e02, a02, s02, b02, m02, w02, x02, c02, t02, _hi02] = request.security(sy02, "D", trackD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[p03, e03, a03, s03, b03, m03, w03, x03, c03, t03, _hi03] = request.security(sy03, "D", trackD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
