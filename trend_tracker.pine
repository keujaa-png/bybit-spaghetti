[p20, e20, a20, s20, b20, m20, w20, x20, c20, t20, _hi20] = request.security(sy20, "D", trackD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[p21, e21, a21, s21, b21, m21, w21, x21, c21, t21, _hi21] = request.security(sy21, "D", trackD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[p22, e22, a22, s22, b22, m22, w22, x22, c22, t22, _hi22] = request.security(sy22, "D", trackD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
