[p17, e17, a17, s17, b17, m17, w17, x17, c17, t17, _hi17] = request.security(sy17, "D", trackD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[p18, e18, a18, s18, b18, m18, w18, x18, c18, t18, _hi18] = request.security(sy18, "D", trackD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
