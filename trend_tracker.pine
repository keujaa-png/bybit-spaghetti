sy17 = input.symbol("BYBIT:VVVUSDT.P", "#17", group="Univers surveillé (mis à jour chaque jour)")
sy18 = input.symbol("BYBIT:SUIUSDT.P", "#18", group="Univers surveillé (mis à jour chaque jour)")
sy19 = input.symbol("BYBIT:FARTCOINUSDT.P", "#19", group="Univers surveillé (mis à jour chaque jour)")
