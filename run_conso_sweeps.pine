[w34, d34, v34, r34, q34, x34, g34, h34, t34] = request.security(sy34, "D", setupD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[w35, d35, v35, r35, q35, x35, g35, h35, t35] = request.security(sy35, "D", setupD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[w36, d36, v36, r36, q36, x36, g36, h36, t36] = request.security(sy36, "D", setupD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[w37, d37, v37, r37, q37, x37, g37, h37, t37] = request.security(sy37, "D", setupD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[w38, d38, v38, r38, q38, x38, g38, h38, t38] = request.security(sy38, "D", setupD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)

tick(string s) =>
    str.replace(str.replace(str.replace(s, "BYBIT:", ""), ".P", ""), "USDT", "")

pos = tblPos == "Haut droite" ? position.top_right : tblPos == "Bas droite" ? position.bottom_right : tblPos == "Bas gauche" ? position.bottom_left : position.top_left
var table tb = table.new(pos, 6, 34, bgcolor = color.new(color.black, 12), border_width = 1)
newDay = timeframe.change("D")

if barstate.islast
    ss = array.from(sy01, sy02, sy03, sy04, sy05, sy06, sy07, sy08, sy09, sy10, sy11, sy12, sy13, sy14, sy15, sy16, sy17, sy18, sy19, sy20, sy21, sy22, sy23, sy24, sy25, sy26, sy27, sy28, sy29, sy30, sy31, sy32, sy33, sy34, sy35, sy36, sy37, sy38)
    ws = array.from(w01, w02, w03, w04, w05, w06, w07, w08, w09, w10, w11, w12, w13, w14, w15, w16, w17, w18, w19, w20, w21, w22, w23, w24, w25, w26, w27, w28, w29, w30, w31, w32, w33, w34, w35, w36, w37, w38)
    ds = array.from(d01, d02, d03, d04, d05, d06, d07, d08, d09, d10, d11, d12, d13, d14, d15, d16, d17, d18, d19, d20, d21, d22, d23, d24, d25, d26, d27, d28, d29, d30, d31, d32, d33, d34, d35, d36, d37, d38)
    vs = array.from(v01, v02, v03, v04, v05, v06, v07, v08, v09, v10, v11, v12, v13, v14, v15, v16, v17, v18, v19, v20, v21, v22, v23, v24, v25, v26, v27, v28, v29, v30, v31, v32, v33, v34, v35, v36, v37, v38)
    rs = array.from(r01, r02, r03, r04, r05, r06, r07, r08, r09, r10, r11, r12, r13, r14, r15, r16, r17, r18, r19, r20, r21, r22, r23, r24, r25, r26, r27, r28, r29, r30, r31, r32, r33, r34, r35, r36, r37, r38)
    qs = array.from(q01, q02, q03, q04, q05, q06, q07, q08, q09, q10, q11, q12, q13, q14, q15, q16, q17, q18, q19, q20, q21, q22, q23, q24, q25, q26, q27, q28, q29, q30, q31, q32, q33, q34, q35, q36, q37, q38)
    xs = array.from(x01, x02, x03, x04, x05, x06, x07, x08, x09, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29, x30, x31, x32, x33, x34, x35, x36, x37, x38)
    gs = array.from(g01, g02, g03, g04, g05, g06, g07, g08, g09, g10, g11, g12, g13, g14, g15, g16, g17, g18, g19, g20, g21, g22, g23, g24, g25, g26, g27, g28, g29, g30, g31, g32, g33, g34, g35, g36, g37, g38)
    hs = array.from(h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23, h24, h25, h26, h27, h28, h29, h30, h31, h32, h33, h34, h35, h36, h37, h38)
    ts = array.from(t01, t02, t03, t04, t05, t06, t07, t08, t09, t10, t11, t12, t13, t14, t15, t16, t17, t18, t19, t20, t21, t22, t23, t24, t25, t26, t27, t28, t29, t30, t31, t32, t33, t34, t35, t36, t37, t38)
    rank = array.new<float>()
    for i = 0 to 37
        p = array.get(hs, i)
        array.push(rank, na(array.get(ts, i)) or na(p) ? -1e9 : p)
    ordr = array.sort_indices(rank, order.descending)

    table.clear(tb, 0, 0, 5, 33)
    table.cell(tb, 0, 0, "Run + conso · top " + str.tostring(topN) + " " + str.tostring(perfDays) + "j", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, str.tostring(perfDays) + "j %", text_color = color.white, text_size = size.small)
    table.cell(tb, 2, 0, "Run", text_color = color.white, text_size = size.small)
    table.cell(tb, 3, 0, "Conso", text_color = color.white, text_size = size.small)
    table.cell(tb, 4, 0, "Sweep daily", text_color = color.white, text_size = size.small)
    table.cell(tb, 5, 0, "Niveau", text_color = color.white, text_size = size.small)
    string msg = ""
    int row = 1
    for r = 0 to math.min(topN, array.size(ordr)) - 1
        i = array.get(ordr, r)
        if array.get(rank, i) < -1e8
            continue
        d = array.get(ds, i)
        recent = not na(d) and d < recentK
        cons = array.get(qs, i)
        if onlySetup and not recent and not cons
            continue
        name = tick(array.get(ss, i))
        p = array.get(hs, i)
        table.cell(tb, 0, row, name, text_color = color.white, text_size = size.small)
        table.cell(tb, 1, row, str.tostring(p, "#") + "%", text_color = p >= 0 ? color.lime : color.red, text_size = size.small)
        if recent
            table.cell(tb, 2, row, "+" + str.tostring(array.get(rs, i), "#") + "%", text_color = color.silver, text_size = size.small)
            table.cell(tb, 3, row, "", text_size = size.small)
            table.cell(tb, 4, row, d == 0 ? "✔ hier" : "✔ il y a " + str.tostring(d + 1) + " j", text_color = d == 0 ? color.lime : color.new(color.lime, 35), text_size = size.small)
            table.cell(tb, 5, row, str.tostring(array.get(vs, i), "#.####"), text_color = color.silver, text_size = size.small)
        else if cons
            table.cell(tb, 2, row, "", text_size = size.small)
            table.cell(tb, 3, row, str.tostring(array.get(gs, i), "#") + "% / " + str.tostring(consLen) + "j", text_color = color.orange, text_size = size.small)
            table.cell(tb, 4, row, "en conso, à surveiller", text_color = color.orange, text_size = size.small)
            table.cell(tb, 5, row, str.tostring(array.get(xs, i), "#.####"), text_color = color.orange, text_size = size.small)
        else
            table.cell(tb, 2, row, "", text_size = size.small)
            table.cell(tb, 3, row, "", text_size = size.small)
            table.cell(tb, 4, row, "–", text_color = color.gray, text_size = size.small)
            table.cell(tb, 5, row, "", text_size = size.small)
        row += 1
        if newDay and array.get(ws, i)
            msg += name + " (bas de conso " + str.tostring(array.get(vs, i), "#.####") + ", run +" + str.tostring(array.get(rs, i), "#") + "%)  "
    if str.length(msg) > 0
        alert("Sweep run + conso : " + msg, alert.freq_once_per_bar)

plot(na, "ancre", display = display.none)
