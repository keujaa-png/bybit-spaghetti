sy21 = input.symbol("BYBIT:GRASSUSDT.P", "#21", group="Univers surveillé")
sy22 = input.symbol("BYBIT:TAOUSDT.P", "#22", group="Univers surveillé")
sy23 = input.symbol("BYBIT:SEIUSDT.P", "#23", group="Univers surveillé")
sy24 = input.symbol("BYBIT:ARBUSDT.P", "#24", group="Univers surveillé")
