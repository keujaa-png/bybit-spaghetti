sy13 = input.symbol("BYBIT:STRKUSDT.P", "#13", group="Univers surveillé")
sy14 = input.symbol("BYBIT:ENAUSDT.P", "#14", group="Univers surveillé")
sy15 = input.symbol("BYBIT:1000PEPEUSDT.P", "#15", group="Univers surveillé")
sy16 = input.symbol("BYBIT:AVAXUSDT.P", "#16", group="Univers surveillé")
sy17 = input.symbol("BYBIT:VVVUSDT.P", "#17", group="Univers surveillé")
sy18 = input.symbol("BYBIT:SUIUSDT.P", "#18", group="Univers surveillé")
sy19 = input.symbol("BYBIT:FARTCOINUSDT.P", "#19", group="Univers surveillé")
