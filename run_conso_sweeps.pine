sy30 = input.symbol("BYBIT:TIAUSDT.P", "#30", group="Univers surveillé")
sy31 = input.symbol("BYBIT:BTCUSDT.P", "#31", group="Univers surveillé")
sy32 = input.symbol("BYBIT:ETHUSDT.P", "#32", group="Univers surveillé")
sy33 = input.symbol("BYBIT:SOLUSDT.P", "#33", group="Univers surveillé")
sy34 = input.symbol("BYBIT:XRPUSDT.P", "#34", group="Univers surveillé")
sy35 = input.symbol("BYBIT:HYPEUSDT.P", "#35", group="Univers surveillé")
sy36 = input.symbol("BYBIT:DOGEUSDT.P", "#36", group="Univers surveillé")
sy37 = input.symbol("BYBIT:ZECUSDT.P", "#37", group="Univers surveillé")
sy38 = input.symbol("BYBIT:BNBUSDT.P", "#38", group="Univers surveillé")

// Sur la daily. Les valeurs « sweep » viennent de la dernière bougie clôturée ([1]) : pas de repaint.
setupD() =>
    cHi = ta.highest(high, consLen)[1]
    cLo = ta.lowest(low, consLen)[1]
    rangePct = cLo > 0 ? (cHi - cLo) / cLo * 100 : na
    runStart = ta.lowest(low, runLen)[consLen + 1]
    runPct = runStart > 0 ? (cHi / runStart - 1) * 100 : na
    holds = cLo >= runStart + (cHi - runStart) * (1 - retrMax / 100)
    isCons = rangePct <= consMax and runPct >= runMin and holds
    rng = high - low
    wickOk = rng > 0 and (math.min(open, close) - low) / rng * 100 >= wickMin
    sweep = isCons and low < cLo and close > cLo and wickOk
    since = ta.barssince(sweep)
    lvl = ta.valuewhen(sweep, cLo, 0)
    runAt = ta.valuewhen(sweep, runPct, 0)
    perf = close[perfDays] > 0 ? (close / close[perfDays] - 1) * 100 : na
    // conso en cours = les consLen dernières bougies clôturées (valeurs de la bougie du jour, déjà décalées)
    [sweep[1], since[1], lvl[1], runAt[1], isCons, cLo, rangePct, perf, time[1]]

[w01, d01, v01, r01, q01, x01, g01, h01, t01] = request.security(sy01, "D", setupD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[w02, d02, v02, r02, q02, x02, g02, h02, t02] = request.security(sy02, "D", setupD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
[w03, d03, v03, r03, q03, x03, g03, h03, t03] = request.security(sy03, "D", setupD(), lookahead = barmerge.lookahead_on, ignore_invalid_symbol = true)
