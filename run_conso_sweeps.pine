sy09 = input.symbol("BYBIT:SAGAUSDT.P", "#9", group="Univers surveillé")
sy10 = input.symbol("BYBIT:KERNELUSDT.P", "#10", group="Univers surveillé")
sy11 = input.symbol("BYBIT:PHAUSDT.P", "#11", group="Univers surveillé")
