// kind : 1 = sweep, 2 = breakout, 3 = les deux sur la même bougie
core() =>
    cHi = ta.highest(high, consLen)[1]
    cLo = ta.lowest(low, consLen)[1]
    rangePct = cLo > 0 ? (cHi - cLo) / cLo * 100 : na
    runStart = ta.lowest(low, runLen)[consLen + 1]
    lb = ta.lowestbars(low, runLen)[consLen + 1]
    runPct = runStart > 0 ? (cHi / runStart - 1) * 100 : na
    holds = cLo >= runStart + (cHi - runStart) * (1 - retrMax / 100)
    isCons = rangePct <= consMax and runPct >= runMin and holds
    rng = high - low
    wickOk = rng > 0 and (math.min(open, close) - low) / rng * 100 >= wickMin
    sweep = useSweep and isCons and low < cLo and close > cLo and wickOk
    volAvg = ta.sma(volume, 20)[1]
    brk = useBreak and isCons and close > cHi and (volMult <= 0 or volume >= volMult * volAvg)
    kind = sweep and brk ? 3 : brk ? 2 : sweep ? 1 : 0
    [cHi, cLo, rangePct, runStart, lb, runPct, isCons, kind]

setupD() =>
    [cHi, cLo, rangePct, runStart, lb, runPct, isCons, kind] = core()
    sig = kind > 0
    since = ta.barssince(sig)
    lastKind = ta.valuewhen(sig, kind, 0)
    lvl = ta.valuewhen(sig, kind == 2 ? cHi : cLo, 0)
    runAt = ta.valuewhen(sig, runPct, 0)
    sigClose = ta.valuewhen(sig, close, 0)
    perf = close[perfDays] > 0 ? (close / close[perfDays] - 1) * 100 : na
    depuis = sigClose[1] > 0 ? (close / sigClose[1] - 1) * 100 : na
    // signal = dernière bougie clôturée ([1]) ; conso en cours = valeurs de la bougie du jour (déjà décalées)
    dayChg = close[1] > 0 ? (close / close[1] - 1) * 100 : na     // variation du jour (bougie en cours)
    [kind[1], since[1], lastKind[1], lvl[1], runAt[1], isCons, cLo, cHi, rangePct, perf, depuis, time[1], dayChg]

drawD() =>
    [cHi, cLo, rangePct, runStart, lb, runPct, isCons, kind] = core()
    sig = kind > 0
    tCs = time[consLen]
    tRun = time[math.max(0, consLen + 1 - nz(lb))]
    [ta.valuewhen(sig, time, 0)[1], ta.valuewhen(sig, tCs, 0)[1], ta.valuewhen(sig, cHi, 0)[1], ta.valuewhen(sig, cLo, 0)[1], ta.valuewhen(sig, tRun, 0)[1], ta.valuewhen(sig, runStart, 0)[1], ta.valuewhen(sig, runPct, 0)[1], ta.valuewhen(sig, low, 0)[1], ta.valuewhen(sig, high, 0)[1], ta.valuewhen(sig, kind, 0)[1],
     ta.valuewhen(sig, time, 1)[1], ta.valuewhen(sig, tCs, 1)[1], ta.valuewhen(sig, cHi, 1)[1], ta.valuewhen(sig, cLo, 1)[1], ta.valuewhen(sig, tRun, 1)[1], ta.valuewhen(sig, runStart, 1)[1], ta.valuewhen(sig, runPct, 1)[1], ta.valuewhen(sig, low, 1)[1], ta.valuewhen(sig, high, 1)[1], ta.valuewhen(sig, kind, 1)[1],
     ta.valuewhen(sig, time, 2)[1], ta.valuewhen(sig, tCs, 2)[1], ta.valuewhen(sig, cHi, 2)[1], ta.valuewhen(sig, cLo, 2)[1], ta.valuewhen(sig, tRun, 2)[1], ta.valuewhen(sig, runStart, 2)[1], ta.valuewhen(sig, runPct, 2)[1], ta.valuewhen(sig, low, 2)[1], ta.valuewhen(sig, high, 2)[1], ta.valuewhen(sig, kind, 2)[1],
     isCons, cHi, cLo, tCs, runStart, tRun, runPct]

