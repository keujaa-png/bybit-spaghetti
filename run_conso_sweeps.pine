//@version=6
indicator("Run + Conso : Sweep / Breakout (top 20 weekly Bybit)", shorttitle="Run+Conso", overlay=true, max_boxes_count=50, max_lines_count=100, max_labels_count=100, max_bars_back=500)

// Momentum sur les coins qui performent le mieux :
// un RUN (forte hausse), puis une CONSOLIDATION serrée qui garde l'essentiel du run, puis
//   • un SWEEP : la bougie daily passe sous le bas de la conso et reclôture dedans (mèche marquée)
//   • et/ou un BREAKOUT : la bougie daily clôture au-dessus du haut de la conso, avec du volume.
// Le panneau classe l'univers par performance sur 7 jours et affiche les 20 meilleurs.
// Signaux calculés sur bougies daily clôturées : pas de repaint.

topN      = input.int(20, "Nombre de coins (top weekly)", minval=5, maxval=30, group="Sélection")
perfDays  = input.int(7, "Performance sur N jours", minval=1, maxval=30, group="Sélection")
runLen    = input.int(20, "Run : fenêtre (jours avant la conso)", minval=5, maxval=60, group="Run")
runMin    = input.float(30, "Run : hausse minimale (%)", minval=5, step=5, group="Run")
consLen   = input.int(4, "Consolidation : durée (jours)", minval=2, maxval=20, group="Consolidation")
consMax   = input.float(25, "Consolidation : range max (%)", minval=3, step=1, group="Consolidation")
retrMax   = input.float(50, "Consolidation : retracement max du run (%)", minval=10, maxval=100, step=5, group="Consolidation")
useSweep  = input.bool(true, "Détecter les sweeps (sous le bas de la conso)", group="Signaux")
wickMin   = input.float(25, "Sweep : mèche basse ≥ % de la bougie", minval=0, maxval=100, group="Signaux")
useBreak  = input.bool(true, "Détecter les breakouts (clôture au-dessus du haut de la conso)", group="Signaux")
volMult   = input.float(1.3, "Breakout : volume ≥ x × moyenne 20 j", minval=0, step=0.1, group="Signaux")
recentK   = input.int(7, "Afficher les signaux des K derniers jours", minval=1, maxval=30, group="Affichage")
onlySetup = input.bool(false, "N'afficher que les coins en conso ou avec signal", group="Affichage")
tblPos    = input.string("Haut droite", "Position du panneau", options=["Haut droite", "Haut gauche", "Bas droite", "Bas gauche"], group="Affichage")
showDraw  = input.bool(true, "Dessiner le setup sur le coin affiché", group="Graphique")
nDraw     = input.int(3, "Nombre de signaux dessinés", minval=1, maxval=3, group="Graphique")

