arrowTxt(float d) =>
    na(d) ? "" : (d > 0 ? "▲ +" : d < 0 ? "▼ " : "= ") + str.tostring(d, "#.#") + "%"
arrowCol(float d) =>
    na(d) ? color.gray : d > 0 ? color.lime : d < 0 ? color.red : color.silver

tick(string s) =>
    parts = str.split(s, ":")
    t = array.size(parts) > 1 ? array.get(parts, 1) : s
    str.replace(str.replace(t, ".P", ""), "USDT", "")
kindTxt(int k) =>
    k == 3 ? "sweep + breakout" : k == 2 ? "🚀 breakout" : "↩ sweep"

pos = tblPos == "Haut droite" ? position.top_right : tblPos == "Bas droite" ? position.bottom_right : tblPos == "Bas gauche" ? position.bottom_left : position.top_left
