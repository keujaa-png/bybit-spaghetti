    gs = array.from(g01, g02, g03, g04, g05, g06, g07, g08, g09, g10, g11, g12, g13, g14, g15, g16, g17, g18, g19, g20, g21, g22, g23, g24, g25, g26, g27, g28, g29, g30, g31, g32, g33, g34, g35, g36, g37, g38)
    hs = array.from(h01, h02, h03, h04, h05, h06, h07, h08, h09, h10, h11, h12, h13, h14, h15, h16, h17, h18, h19, h20, h21, h22, h23, h24, h25, h26, h27, h28, h29, h30, h31, h32, h33, h34, h35, h36, h37, h38)
    cs = array.from(c01, c02, c03, c04, c05, c06, c07, c08, c09, c10, c11, c12, c13, c14, c15, c16, c17, c18, c19, c20, c21, c22, c23, c24, c25, c26, c27, c28, c29, c30, c31, c32, c33, c34, c35, c36, c37, c38)
    ts = array.from(t01, t02, t03, t04, t05, t06, t07, t08, t09, t10, t11, t12, t13, t14, t15, t16, t17, t18, t19, t20, t21, t22, t23, t24, t25, t26, t27, t28, t29, t30, t31, t32, t33, t34, t35, t36, t37, t38)
    dcs = array.from(dc01, dc02, dc03, dc04, dc05, dc06, dc07, dc08, dc09, dc10, dc11, dc12, dc13, dc14, dc15, dc16, dc17, dc18, dc19, dc20, dc21, dc22, dc23, dc24, dc25, dc26, dc27, dc28, dc29, dc30, dc31, dc32, dc33, dc34, dc35, dc36, dc37, dc38)
    rank = array.new<float>()
    for i = 0 to 37
        p = array.get(hs, i)
        array.push(rank, na(array.get(ts, i)) or na(p) ? -1e9 : p)
    ordr = array.sort_indices(rank, order.descending)

    table.clear(tb, 0, 0, 6, 33)
    table.cell(tb, 0, 0, "Run + conso · top " + str.tostring(topN) + " " + str.tostring(perfDays) + "j", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 0, "Jour", text_color = color.white, text_size = size.small)
    table.cell(tb, 2, 0, str.tostring(perfDays) + "j %", text_color = color.white, text_size = size.small)
    table.cell(tb, 3, 0, "Run", text_color = color.white, text_size = size.small)
    table.cell(tb, 4, 0, "Signal daily", text_color = color.white, text_size = size.small)
    table.cell(tb, 5, 0, "Depuis", text_color = color.white, text_size = size.small)
    table.cell(tb, 6, 0, "Niveau", text_color = color.white, text_size = size.small)
    string msgB = ""
    string msgS = ""
    int row = 1
    for r = 0 to math.min(topN, array.size(ordr)) - 1
        i = array.get(ordr, r)
        if array.get(rank, i) < -1e8
            continue
        d = array.get(ds, i)
        recent = not na(d) and d < recentK
        cons = array.get(qs, i)
        if onlySetup and not recent and not cons
            continue
        name = tick(array.get(sys, i))
        p = array.get(hs, i)
        lk = int(array.get(js, i))
        table.cell(tb, 0, row, name, text_color = color.white, text_size = size.small)
        dcv = array.get(dcs, i)
        table.cell(tb, 1, row, arrowTxt(dcv), text_color = arrowCol(dcv), text_size = size.small)
        table.cell(tb, 2, row, str.tostring(p, "#") + "%", text_color = p >= 0 ? color.lime : color.red, text_size = size.small)
        if recent
            dep = array.get(cs, i)
            sigCol = lk == 1 ? color.lime : color.aqua
            table.cell(tb, 3, row, "+" + str.tostring(array.get(rs, i), "#") + "%", text_color = color.silver, text_size = size.small)
            table.cell(tb, 4, row, kindTxt(lk) + (d == 0 ? " hier" : " il y a " + str.tostring(d + 1) + " j"), text_color = d == 0 ? sigCol : color.new(sigCol, 35), text_size = size.small)
            table.cell(tb, 5, row, na(dep) ? "" : (dep >= 0 ? "+" : "") + str.tostring(dep, "#.#") + "%", text_color = na(dep) ? color.gray : dep >= 0 ? color.lime : color.red, text_size = size.small)
            table.cell(tb, 6, row, str.tostring(array.get(vs, i), "#.####"), text_color = color.silver, text_size = size.small)
        else if cons
            table.cell(tb, 3, row, "", text_size = size.small)
            table.cell(tb, 4, row, "en conso (" + str.tostring(array.get(gs, i), "#") + "%) : guetter", text_color = color.orange, text_size = size.small)
            table.cell(tb, 5, row, "", text_size = size.small)
            table.cell(tb, 6, row, str.tostring(array.get(xs, i), "#.####") + " / " + str.tostring(array.get(ys, i), "#.####"), text_color = color.orange, text_size = size.small)
        else
            for col = 3 to 6
                table.cell(tb, col, row, col == 4 ? "–" : "", text_color = color.gray, text_size = size.small)
        row += 1
        k = int(array.get(ks, i))
        if newDay and k > 0
            if k >= 2
                msgB += name + " (haut conso " + str.tostring(array.get(ys, i), "#.####") + ")  "
            if k == 1 or k == 3
                msgS += name + " (bas conso " + str.tostring(array.get(xs, i), "#.####") + ")  "
    if str.length(msgB) > 0 or str.length(msgS) > 0
        alert("Run+conso · " + (str.length(msgB) > 0 ? "BREAKOUT : " + msgB : "") + (str.length(msgS) > 0 ? "SWEEP : " + msgS : ""), alert.freq_once_per_bar)

// ═══ Dessin sur le coin affiché ═════════════════════════════════════════
var array<box>   dBoxes  = array.new<box>()
var array<line>  dLines  = array.new<line>()
var array<label> dLabels = array.new<label>()
const int DAY = 86400000

drawSetup(int tSig, int tCs, float hi, float lo, int tRun, float runLow, float runPct, float barLow, float barHigh, int k, bool last) =>
    array.push(dBoxes, box.new(tCs, hi, tSig, lo, xloc = xloc.bar_time, border_color = color.new(color.orange, 20), bgcolor = color.new(color.orange, 85)))
    if k == 1 or k == 3
        array.push(dLines, line.new(tCs, lo, tSig + 5 * DAY, lo, xloc = xloc.bar_time, color = color.new(color.lime, 10), style = line.style_dashed))
        array.push(dLabels, label.new(tSig, barLow, (last ? "SWEEP ✔ " : "sweep ") + str.tostring(lo, format.mintick), xloc = xloc.bar_time, style = label.style_label_up, color = color.new(color.lime, last ? 0 : 40), textcolor = color.black, size = last ? size.normal : size.small))
    if k >= 2
        array.push(dLines, line.new(tCs, hi, tSig + 5 * DAY, hi, xloc = xloc.bar_time, color = color.new(color.aqua, 10), style = line.style_dashed))
        array.push(dLabels, label.new(tSig, barHigh, (last ? "BREAKOUT 🚀 " : "breakout ") + str.tostring(hi, format.mintick), xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.aqua, last ? 0 : 40), textcolor = color.black, size = last ? size.normal : size.small))

if barstate.islast and showDraw
    for b in dBoxes
        box.delete(b)
    for l in dLines
        line.delete(l)
    for lab in dLabels
        label.delete(lab)
    array.clear(dBoxes)
    array.clear(dLines)
    array.clear(dLabels)
    if not na(a0)
        drawSetup(int(a0), int(b0), c0, e0, int(f0), g0, h0, l0, u0, int(k0), true)
    if nDraw >= 2 and not na(a1)
        drawSetup(int(a1), int(b1), c1, e1, int(f1), g1, h1, l1, u1, int(k1), false)
    if nDraw >= 3 and not na(a2)
        drawSetup(int(a2), int(b2), c2, e2, int(f2), g2, h2, l2, u2, int(k2), false)
    if nowCons
        array.push(dBoxes, box.new(int(nowTcs), nowHi, time_close + DAY, nowLo, xloc = xloc.bar_time, border_color = color.orange, border_style = line.style_dashed, bgcolor = color.new(color.orange, 88)))
        array.push(dLabels, label.new(time_close + DAY, nowHi, "Conso en cours : breakout au-dessus de " + str.tostring(nowHi, format.mintick) + " · sweep sous " + str.tostring(nowLo, format.mintick), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.orange, 15), textcolor = color.black, size = size.small))

plot(na, "ancre", display = display.none)
